# Django Environment Variables
DJANGO_ENV=dev
DEBUG=True
SECRET_KEY=django-insecure-dev-key-change-this-in-production-chronicle-news-2026!
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL in production, SQLite fallback in dev)
# DATABASE_URL=postgres://user:password@localhost:5432/chronicle_news
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
# For PostgreSQL:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=chronicle_db
# DB_USER=chronicle_user
# DB_PASSWORD=your_secure_password
# DB_HOST=localhost
# DB_PORT=5432

# Security (Production only)
SECURE_SSL_REDIRECT=False
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Email (SMTP in production, console in dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="The Chronicle" <noreply@chronicle.com>
