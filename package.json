{
  "name": "chronicle-news",
  "version": "1.0.0",
  "description": "Production-ready editorial news publication platform with Django 5 and TailwindCSS",
  "main": "index.js",
  "scripts": {
    "build:css": "tailwindcss -i ./static/css/input.css -o ./static/css/style.css --minify",
    "watch:css": "tailwindcss -i ./static/css/input.css -o ./static/css/style.css --watch"
  },
  "keywords": ["django", "news", "journalism", "tailwindcss", "editorial"],
  "author": "Antigravity & Editorial Team",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.10",
    "tailwindcss": "^3.4.1"
  }
}
